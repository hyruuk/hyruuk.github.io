---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pick, t, type Lang } from '../i18n/utils';
import { site } from '../lib/data';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<BaseLayout lang={lang} path="/" place={{ kind: 'home' }} kind="home">
  <h1 class="sr-only" tabindex="-1">{site.name} — {pick(site.role, lang)} · {pick(site.position, lang)}</h1>
  <p class="home-hint reveal" aria-hidden="true">{t(lang, 'map.hint')}</p>
  <script>
    import { onPage } from '../scripts/lifecycle';

    // First visit of the session: the places glow once, left to right, to show the art is clickable.
    onPage(() => {
      if (document.documentElement.dataset.kind !== 'home') return;
      const world = document.getElementById('world');
      if (!world || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      try {
        if (sessionStorage.getItem('hinted')) return;
        sessionStorage.setItem('hinted', '1');
      } catch {
        /* private mode: hint anyway */
      }
      const start = () => {
        world.classList.add('is-hinting');
        window.setTimeout(() => world.classList.remove('is-hinting'), 2800);
      };
      if (world.dataset.loaded !== undefined) window.setTimeout(start, 400);
      else world.querySelector('.world-img')?.addEventListener('load', () => window.setTimeout(start, 400), { once: true });
    });
  </script>
</BaseLayout>
