---

{
  filled[name] ? (
    <svg class:list={['icon', cls]} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={filled[name]} />
    </svg>
  ) : (
    <svg
      class:list={['icon', cls]}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={stroked[name] ?? stroked.external}
    />
  )
}
