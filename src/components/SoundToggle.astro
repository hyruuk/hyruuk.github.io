---
/**
 * The little wave from the mockup = the music toggle. Until a visitor has used it once, it gently
 * "breathes" and, on the home panel, a small "♪ play music" hint fades in once per visit
 * (#player[data-known] / [data-hinted], set by src/scripts/player.ts). The player itself lives in #player
 * (src/components/Player.astro), outside the swapped page, so it keeps playing across pages.
 */
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="sound">
  <button
    class="sound-toggle"
    type="button"
    aria-pressed="false"
    aria-label={t(lang, 'sound.on')}
    data-label-on={t(lang, 'sound.on')}
    data-label-off={t(lang, 'sound.off')}
  >
    {/* two layers moved by the compositor (transform/opacity of HTML boxes only): the still wave, and the running one */}
    <span class="wave" aria-hidden="true">
      <span class="wave__still">
        <svg viewBox="0 0 64 20">
          <path d="M2 15.5c6 0 8.4-1.2 11.6-6.2S19 2.6 22 2.6s5.4 1.8 8.4 6.7 5.6 6.2 11.6 6.2" />
        </svg>
      </span>
      {/* exactly five periods of 16 units, from trough to trough: one period more than the window shows */}
      <span class="wave__live">
        <span class="wave__run">
          <svg viewBox="0 0 80 20">
            <path d="M0 17c4 0 4-14 8-14s4 14 8 14 4-14 8-14 4 14 8 14 4-14 8-14 4 14 8 14 4-14 8-14 4 14 8 14 4-14 8-14 4 14 8 14" />
          </svg>
        </span>
      </span>
    </span>
    <span class="sound-hint" aria-hidden="true">♪ {t(lang, 'sound.hint')}</span>
  </button>
  <div class="spectrum" aria-hidden="true"><i></i><i></i><i></i></div>
</div>
